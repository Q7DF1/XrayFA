+func (r *walReader) pollExact() (advanced, eof bool, err error) {
+	for i := 0; i < r.concurrency; i++ {
+		name := objectName(r.prefix, r.seq, segSuffix)
+		chunk, getErr := r.storage.Get(r.ctx, name)
+		if getErr == nil {
+			if len(chunk) == 0 {
+				return advanced, false, nil
+			}
+			select {
+			case r.ch <- chunk:
+			case <-r.ctx.Done():
+				return advanced, true, nil
+			}
+			r.seq++
+			advanced = true
+			r.holeSince = time.Time{}
+			r.controlProbeAt = time.Now()
+			r.discard(name)
+			continue
+		}
+		if getErr != errNotFound {
+			return advanced, false, getErr
+		}
+		// Missing data is the common idle case. Probing three control objects
+		// on every poll serializes extra service round trips ahead of the next
+		// data read. Check controls periodically while polling data normally.
+		if r.controlProbeAt.IsZero() {
+			r.controlProbeAt = time.Now()
+		}
+		if time.Since(r.controlProbeAt) < max(5*time.Second, r.maxPollInterval) {
+			return advanced, false, nil
+		}
+		r.controlProbeAt = time.Now()
+		for _, suffix := range []string{errSuffix, endSuffix} {
+			marker := objectName(r.prefix, r.seq, suffix)
+			if _, markerErr := r.storage.Get(r.ctx, marker); markerErr == nil {
+				r.discard(marker)
+				if suffix == errSuffix {
+					return advanced, false, errors.New("the peer could not store segment ", r.seq)
+				}
+				return advanced, true, nil
+			} else if markerErr != errNotFound {
+				return advanced, false, markerErr
+			}
+		}
+		// Preserve missing-segment detection without an unbounded directory scan.
+		if next, nextErr := r.storage.Get(r.ctx, objectName(r.prefix, r.seq+1, segSuffix)); nextErr == nil && len(next) > 0 {
+			if r.holeSince.IsZero() {
+				r.holeSince = time.Now()
+			} else if time.Since(r.holeSince) >= r.holeTimeout {
+				return advanced, false, errors.New("segment ", r.seq, " never arrived while later ones did, the peer lost it")
+			}
+		} else if nextErr != nil && nextErr != errNotFound {
+			return advanced, false, nextErr
+		} else {
