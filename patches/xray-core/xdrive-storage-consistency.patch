+package xdrive
+
+import (
+	"bytes"
+	"context"
+	"testing"
+	"time"
+)
+
+type pendingPutStorage struct {
+	Storage
+	name    string
+	pending bool
+}
+
+func (s *pendingPutStorage) Get(ctx context.Context, n string) ([]byte, error) {
+	if n == s.name && s.pending {
+		s.pending = false
+		return []byte{}, nil
+	}
+	return s.Storage.Get(ctx, n)
+}
+func TestWALRetriesVisibleEmptySegmentWithoutLosingBytes(t *testing.T) {
+	ctx := context.Background()
+	base, err := newLocalStorage(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := objectName("up", 0, segSuffix)
+	second := objectName("up", 1, segSuffix)
+	base.Put(ctx, first, []byte("encrypted record 2"))
+	base.Put(ctx, second, []byte("encrypted record 3"))
+	s := &pendingPutStorage{Storage: base, name: first, pending: true}
+	p := paramsFromConfig(&Config{Concurrency: 2})
+	r := &walReader{ctx: ctx, storage: s, prefix: "up", params: p, ch: make(chan []byte, 2), discards: make(chan string, 8)}
+	advanced, eof, err := r.poll()
+	if err != nil || advanced || eof || r.seq != 0 || len(r.ch) != 0 || len(r.discards) != 0 {
+		t.Fatalf("incomplete PUT consumed: advanced=%v eof=%v seq=%d queued=%d discards=%d err=%v", advanced, eof, r.seq, len(r.ch), len(r.discards), err)
+	}
+	advanced, eof, err = r.poll()
+	if err != nil || !advanced || eof || r.seq != 2 {
+		t.Fatalf("completed PUT not retried: advanced=%v eof=%v seq=%d err=%v", advanced, eof, r.seq, err)
+	}
+	if !bytes.Equal(<-r.ch, []byte("encrypted record 2")) || !bytes.Equal(<-r.ch, []byte("encrypted record 3")) {
+		t.Fatal("stream lost bytes or changed order")
+	}
+}
+
+type exactPendingStorage struct{ *pendingPutStorage }
+
+func (s *exactPendingStorage) directWALReads() bool { return true }
+func (s *exactPendingStorage) List(context.Context, string) ([]Entry, error) {
+	panic("exact reads must not enumerate the shared directory")
+}
+func TestExactWALRetriesEmptyAndPreservesEndMarker(t *testing.T) {
+	ctx := context.Background()
+	base, err := newLocalStorage(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := objectName("up", 0, segSuffix)
+	base.Put(ctx, first, []byte("record"))
+	base.Put(ctx, objectName("up", 1, endSuffix), nil)
+	s := &exactPendingStorage{&pendingPutStorage{Storage: base, name: first, pending: true}}
+	p := paramsFromConfig(&Config{Concurrency: 2})
+	r := &walReader{ctx: ctx, storage: s, prefix: "up", params: p, ch: make(chan []byte, 2), discards: make(chan string, 8)}
+	advanced, eof, err := r.poll()
+	if err != nil || advanced || eof || r.seq != 0 || len(r.discards) != 0 {
+		t.Fatalf("empty object consumed: seq=%d error=%v", r.seq, err)
+	}
+	advanced, eof, err = r.poll()
+	if err != nil || !advanced || eof || r.seq != 1 || string(<-r.ch) != "record" {
+		t.Fatalf("stream lost: seq=%d advanced=%v eof=%v error=%v", r.seq, advanced, eof, err)
+	}
+	r.controlProbeAt = time.Now().Add(-6 * time.Second)
+	advanced, eof, err = r.poll()
+	if err != nil || advanced || !eof {
+		t.Fatalf("end marker lost: advanced=%v eof=%v err=%v", advanced, eof, err)
+	}
+}
