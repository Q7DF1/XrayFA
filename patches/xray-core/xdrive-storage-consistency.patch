+package xdrive
+
+import (
+	"context"
+	"testing"
+)
+
+func TestFlattenedSessionCleanupPreservesNeighbors(t *testing.T) {
+	store := newFakeStore(t)
+	settings := templateSettings(store, nil, nil)
+	s, err := newTemplateStorage(settings, settings.ProtocolSettings.(*Config))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	ctx := context.Background()
+	names := []string{"streams/session/c2s/000000000.seg", "streams/session/s2c/000000001.end", "streams/session-extra/c2s/000000000.seg", "sessions/123-session"}
+	for _, n := range names {
+		if err := s.Put(ctx, n, []byte("data")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := s.Delete(ctx, "streams/session"); err != nil {
+		t.Fatal(err)
+	}
+	for i, n := range names {
+		_, err := s.Get(ctx, n)
+		if i < 2 && err != errNotFound {
+			t.Fatalf("stale object %s: %v", n, err)
+		}
+		if i >= 2 && err != nil {
+			t.Fatalf("neighbor removed %s: %v", n, err)
+		}
+	}
+	if err := s.Delete(ctx, "streams/session"); err != nil {
+		t.Fatalf("cleanup must be idempotent: %v", err)
+	}
+}
