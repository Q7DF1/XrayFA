<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <ImageView
        android:id="@+id/widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_background"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_node"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_add_node"
                android:textColor="@color/widget_on_surface"
                android:maxLines="1"
                android:ellipsize="end"
                style="@style/Widget.XrayFA.Text.TitleMedium" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/widget_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/widget_dot"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_compact_disconnected"
                    android:textColor="@color/widget_on_surface_variant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    style="@style/Widget.XrayFA.Text.BodyMedium" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
            <ImageView
                android:id="@+id/widget_power_surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_power_compact_background"
                android:importantForAccessibility="no" />
            <ImageButton
                android:id="@+id/widget_power"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/widget_ic_power"
                android:background="@android:color/transparent"
                android:contentDescription="@string/start" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
