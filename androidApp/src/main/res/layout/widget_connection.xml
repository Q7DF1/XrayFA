<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <ImageView
        android:id="@+id/widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_background"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/widget_on_surface_variant"
                android:maxLines="1"
                android:id="@+id/widget_brand"
                style="@style/Widget.XrayFA.Text.LabelLarge" />
            <ImageView
                android:id="@+id/widget_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/widget_dot"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/not_connected"
                android:textColor="@color/widget_on_surface_variant"
                android:maxLines="1"
                style="@style/Widget.XrayFA.Text.LabelLarge" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_node"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_add_node"
                    android:textColor="@color/widget_on_surface"
                    android:maxLines="1"
                    android:ellipsize="end"
                    style="@style/Widget.XrayFA.Text.TitleLarge" />
                <TextView
                    android:id="@+id/widget_endpoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textColor="@color/widget_on_surface_variant" />
                <TextView
                    android:id="@+id/widget_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/widget_tap_connect"
                    android:textColor="@color/widget_on_surface_variant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    style="@style/Widget.XrayFA.Text.BodyMedium" />
                <Chronometer
                    android:id="@+id/widget_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/widget_on_surface_variant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    style="@style/Widget.XrayFA.Text.BodyMedium" />
            </LinearLayout>
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <ImageView
                    android:id="@+id/widget_power_surface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_power_background"
                    android:importantForAccessibility="no" />
                <ImageButton
                    android:id="@+id/widget_power"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:src="@drawable/widget_ic_power"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/start" />
            </FrameLayout>
        </LinearLayout>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:id="@+id/widget_divider"
            android:src="@color/widget_outline_variant" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_download"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="↓ —"
                android:textColor="@color/widget_on_surface"
                android:maxLines="2"
                android:ellipsize="end"
                style="@style/Widget.XrayFA.Text.TitleMedium" />
            <TextView
                android:id="@+id/widget_upload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="↑ —"
                android:textColor="@color/widget_on_surface"
                android:maxLines="2"
                android:ellipsize="end"
                style="@style/Widget.XrayFA.Text.TitleMedium" />
            <TextView
                android:id="@+id/widget_switch"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/widget_switch_node"
                android:textColor="@color/widget_on_surface_variant"
                android:maxLines="1"
                style="@style/Widget.XrayFA.Text.LabelLarge" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
